# --- iOS / Xcode ---
# Artefactos de build (DerivedData) y datos de usuario de Xcode. El .xcodeproj se versiona para
# abrir directo; si preferís, se regenera con `xcodegen generate` desde iosApp/project.yml.
/iosApp/build/
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# --- Secretos / config local ---
# local.properties lleva la API key y la ruta del SDK. Usá local.properties.example de plantilla.

# --- Python (scripts de tools/) ---
__pycache__/
*.pyc

# --- Datos personales de prueba ---
# Si te armas un seed con tu coleccion real para tu build local, dejalo fuera del repo.
/app/src/main/assets/seed/collection.local.json
