<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para descargar las carátulas (Libretro Thumbnails) con Coil. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Solo para que el SDK de errores sepa si hay conexión y **encole** el reporte en vez de
         intentar mandarlo y perderlo. Es un permiso normal: no se le pide nada al usuario, y no da
         acceso a ningún dato. Sin él, un crash sin red se reintenta a ciegas. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notas de voz: se graba PCM 16 kHz mono (lo que consume Whisper) desde Playing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".FullsetApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DiarioGamer">

        <!-- GlitchTip (protocolo Sentry). El DSN lo inyecta Gradle desde `local.properties`; si está
             vacío el SDK arranca deshabilitado y no manda nada, que es lo que pasa en un clon ajeno.

             `send-default-pii=false` es el default y se deja **explícito** a propósito: esta app
             guarda notas, fotos y una colección personal, y Settings promete que las notas de voz no
             salen del dispositivo. Un reporte de error no puede ser la puerta de atrás de esa
             promesa. Por lo mismo se apagan las capturas automáticas de interacción, que adjuntan
             textos de la pantalla como migas. -->
        <meta-data android:name="io.sentry.dsn" android:value="${glitchtipDsn}" />
        <meta-data android:name="io.sentry.send-default-pii" android:value="false" />
        <meta-data android:name="io.sentry.breadcrumbs.user-interaction" android:value="false" />
        <meta-data android:name="io.sentry.traces.user-interaction.enable" android:value="false" />
        <meta-data android:name="io.sentry.environment" android:value="${glitchtipEnv}" />
        <meta-data android:name="io.sentry.debug" android:value="${glitchtipDebug}" />
        <!-- Muchas transacciones por sesión en móvil: se muestrea bajo, como recomienda GlitchTip. -->
        <meta-data android:name="io.sentry.traces.sample-rate" android:value="0.01" />

        <!-- `singleTop`: al compartir una foto con la app ya abierta se reusa esta instancia y el
             intent llega por `onNewIntent`, en vez de apilar una segunda copia con su propia BD
             abierta y su propio estado. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DiarioGamer">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Recibir imágenes desde el menú Compartir de cualquier app (galería, navegador,
                 captura de pantalla). La app pregunta a qué juego de Playing adjuntarla. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Comparte SOLO cache/captures con la app de cámara, para que pueda escribir ahí la foto
             recién tomada. No exportado y con permiso por URI: nadie más puede leerlo. Al delegar la
             captura en la app de cámara del sistema no hace falta el permiso CAMERA. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
